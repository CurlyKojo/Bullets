# All vars are SERVER-SIDE only. They are NEVER bundled into the browser.
# Copy this file to .env for local dev, and set the same vars in Vercel for production.

# ----- Anthropic -----
ANTHROPIC_API_KEY=sk-ant-...

# ----- GitHub OAuth (https://github.com/settings/applications/new) -----
# Authorization callback URL must match BASE_URL + /api/auth/callback exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated list of GitHub usernames (case-insensitive) allowed to sign in.
ALLOWED_USERS=your-github-username

# ----- Sessions -----
# Random 32+ char string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# Public base URL of the deployment, no trailing slash.
# Local dev: http://localhost:5173
# Vercel:    https://your-app.vercel.app
BASE_URL=http://localhost:5173

# ----- Rate limit (Upstash Redis: https://console.upstash.com/redis) -----
# Copy these from the database's "REST API" section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Default 50 generations per allowed user per day (UTC midnight reset).
DAILY_LIMIT=50
